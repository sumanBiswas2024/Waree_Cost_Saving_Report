<mvc:View controllerName="Z_Cost_Saving_Report.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true">
	<App>
		<pages>
			<Page showHeader="false" class="dashboardPage">
				<content>
					<VBox class="appShell">
						<HBox class="topHeader" alignItems="Center" justifyContent="SpaceBetween">
							<HBox alignItems="Center" class="brand">
								<VBox><Title text="Project Cost Saving Analysis" level="H1"/><Text text="Project-wise BOQ, PO &amp; Cost Saving Overview"/></VBox>
							</HBox>
							<HBox alignItems="Center" class="headerRight"><Text id="refreshText" text="Last Refreshed: —"/><Button icon="sap-icon://refresh" type="Transparent" press="onRefresh"/></HBox>
						</HBox>
						<HBox class="projectBar" alignItems="Center" wrap="Wrap">
							<Label text="Project"/><Input id="projectInput" placeholder="Enter Project ID" width="22rem" showValueHelp="true" valueHelpRequest="onProjectHelp" submit="onGo"/><Button text="Go" type="Emphasized" press="onGo"/><Button text="Reset" press="onReset"/><ToolbarSpacer/><Button icon="sap-icon://excel-attachment" text="Export" press="onExport"/>
						</HBox>
						<MessageStrip id="statusStrip" text="Enter a project ID and choose Go." type="Information" showIcon="true" visible="true"/>
						<HBox class="kpiRow" wrap="Wrap" items="{dash>/kpis}">
							<items>
								<VBox class="kpiCard">
									<HBox alignItems="Center" justifyContent="SpaceBetween"><Text text="{dash>label}"/><core:Icon xmlns:core="sap.ui.core" src="{dash>icon}"/></HBox><Title text="{dash>value}" level="H2"/><Text text="{dash>sub}"/></VBox>
							</items>
						</HBox>
						<HBox class="chartRow" wrap="Wrap">
							<VBox class="chartCard savingChart">
								<HBox justifyContent="SpaceBetween"><Title text="Serial-wise Saving (Top 10)" level="H3"/>
									<Select selectedKey="10" change="onTopChange">
										<items><core:Item xmlns:core="sap.ui.core" key="10" text="Top 10"/><core:Item xmlns:core="sap.ui.core" key="20" text="Top 20"/><core:Item xmlns:core="sap.ui.core" key="all" text="All"/></items>
									</Select>
								</HBox>
								<VBox items="{dash>/savingBars}">
									<items>
										<HBox class="barRow" alignItems="Center"><Text text="{dash>label}" class="barLabel"/>
											<VBox class="barTrack"><HBox class="greenBar" width="{dash>width}"/></VBox><Text text="{dash>amount}" class="barValue"/></HBox>
									</items>
								</VBox>
							</VBox>
							<VBox class="chartCard compareChart"><Title text="BOQ vs PO Amount (Serial Wise)" level="H3"/>
								<HBox class="compareBars" items="{dash>/compareBars}" justifyContent="SpaceAround">
									<items>
										<VBox class="compareGroup"><Text text="{dash>label}"/>
											<HBox alignItems="End" class="barPair"><VBox class="column boqColumn" height="{dash>boqHeight}"/><VBox class="column poColumn" height="{dash>poHeight}"/></HBox><Text text="{dash>boqShort} / {dash>poShort}" class="legendSmall"/></VBox>
									</items>
								</HBox>
								<HBox class="legend"><Text text="● BOQ Amount"/><Text text="● PO Amount"/></HBox>
							</VBox>
							<VBox class="chartCard distChart"><Title text="Amount Overview" level="H3"/>
								<VBox class="distLegend" items="{dash>/distribution/items}">
									<items>
										<HBox class="amountLine"><Text text="{dash>label}"/><ToolbarSpacer/><Text text="{dash>value}"/></HBox>
									</items>
								</VBox><Text text="Values are shown independently from backend fields." class="chartNote"/></VBox>
						</HBox>
						<HBox class="sectionHeader" alignItems="Center">
							<VBox><Title text="Project Details – Serial &amp; Material Wise" level="H2"/><Text text="Rows are grouped by serial, version and project; WBS shows the backend value"/></VBox><ToolbarSpacer/><SearchField width="16rem" placeholder="Search Serial / WBS / Material..." liveChange="onSearch"/><Button text="Expand All" icon="sap-icon://open-command-field" press="onExpandAll"/><Button text="Collapse All" icon="sap-icon://close-command-field" press="onCollapseAll"/></HBox>
						<HBox class="serialHeader" visible="{dash>/hasData}"><Text text=""/><Text text="Serial"/><Text text="Version"/><Text text="WBS"/><Text text="Materials"/><Text text="BOQ Amount"/><Text text="PO Amount"/><Text text="Availability"/><Text text="Saving"/></HBox>
						<VBox class="emptyTableState" visible="{= !${dash>/hasData}}"><core:Icon xmlns:core="sap.ui.core" src="sap-icon://database"/><Text text="{dash>/emptyMessage}"/></VBox>
						<VBox id="serialList" class="serialList" visible="{dash>/hasData}" items="{dash>/serials}">
							<items>
								<VBox class="serialBlock">
									<HBox class="serialParent" alignItems="Center">
										<Button type="Transparent" icon="{= ${dash>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow'}"
											press="onToggleSerial"/>
										<Text text="{dash>serial}"/><Text text="{dash>version}"/><Text text="{dash>wbs}"/><Text text="{dash>materialCount}"/><Text text="{dash>boqFmt}"/><Text text="{dash>poFmt}"/><Text text="{dash>availabilityFmt}"/><ObjectNumber number="{dash>savingFmt}" state="Success"/>
									</HBox>
									<VBox visible="{dash>expanded}" class="serialDetail">
										<HBox class="serialSummary" wrap="Wrap">
											<VBox><Text text="Material Count"/><Title text="{dash>materialCount}"/></VBox>
											<VBox><Text text="BOQ Amount"/><Title text="{dash>boqFmt}"/></VBox>
											<VBox><Text text="PO Amount"/><Title text="{dash>poFmt}"/></VBox>
											<VBox><Text text="Availability"/><Title text="{dash>availabilityFmt}"/></VBox>
											<VBox><Text text="Saving"/><Title text="{dash>savingFmt}"/></VBox>
										</HBox>
										<HBox class="serialCharts" wrap="Wrap">
											<VBox class="chartCard materialChart"><Title text="Material-wise BOQ vs PO" level="H3"/>
												<ScrollContainer horizontal="true" vertical="false" width="100%">
													<HBox class="compareBars" width="{dash>chartWidth}" items="{dash>compareBars}" justifyContent="Start">
														<items>
															<VBox class="compareGroup"><Text text="{dash>label}"/>
																<HBox alignItems="End" class="barPair"><VBox class="column boqColumn" height="{dash>boqHeight}"/><VBox class="column poColumn" height="{dash>poHeight}"/></HBox><Text text="{dash>boqShort} / {dash>poShort}" class="legendSmall"/></VBox>
														</items>
													</HBox>
												</ScrollContainer>
												<HBox class="legend"><Text text="● BOQ"/><Text text="● PO"/></HBox>
											</VBox>
											<VBox class="chartCard materialChart"><Title text="Material-wise Saving" level="H3"/>
												<ScrollContainer horizontal="true" vertical="false" width="100%">
													<VBox items="{dash>savingBars}" width="{dash>chartWidth}" class="savingBars">
														<items>
															<HBox class="barRow" alignItems="Center"><Text text="{dash>label}" class="barLabel"/>
																<VBox class="barTrack"><HBox class="greenBar" visible="{= !${dash>negative}}" width="{dash>width}"/><HBox class="redBar" visible="{dash>negative}" width="{dash>width}"/></VBox><ObjectStatus text="{dash>amount}" state="{dash>state}" class="barValue"/></HBox>
														</items>
													</VBox>
												</ScrollContainer>
											</VBox>
										</HBox>
										<HBox class="tableHeader"><Title text="Material Comparison" level="H3"/><ToolbarSpacer/><Text text="Serial {dash>serial} · Version {dash>version}"/></HBox>
										<ScrollContainer horizontal="true" vertical="true" height="16rem" class="materialScroll">
											<Table items="{dash>materials}" fixedLayout="false">
												<columns>
													<Column><Text text="Material / Service"/></Column>
													<Column><Text text="G/L Account"/></Column>
													<Column hAlign="End"><Text text="BOQ Qty"/></Column>
													<Column hAlign="End"><Text text="BOQ Rate"/></Column>
													<Column hAlign="End"><Text text="BOQ Amount"/></Column>
													<Column hAlign="End"><Text text="PO Qty"/></Column>
													<Column hAlign="End"><Text text="PO Rate"/></Column>
													<Column hAlign="End"><Text text="PO Amount"/></Column>
													<Column hAlign="End"><Text text="Availability"/></Column>
													<Column hAlign="End"><Text text="Saving"/></Column>
												</columns>
												<items>
													<ColumnListItem type="Active" press="onMaterialSelect">
														<cells><Text text="{dash>SERVICE_OR_MATERIAL}"/><Text text="{dash>GL_ACCOUNT}"/><Text text="{dash>BOQ_QTY}"/><Text text="{dash>BOQ_RATE}"/><Text text="{dash>boqFmt}"/><Text text="{dash>PO_QTY}"/><Text text="{dash>PO_RATE}"/><Text text="{dash>poFmt}"/><Text text="{dash>availabilityFmt}"/><ObjectNumber number="{dash>savingFmt}" state="Success"/></cells>
													</ColumnListItem>
												</items>
											</Table>
										</ScrollContainer>
										<HBox class="subtotalRow"><Text text="Subtotal – Serial {dash>serial}"/><ToolbarSpacer/><Text text="{dash>boqFmt}"/><Text text="{dash>poFmt}"/><Text text="{dash>availabilityFmt}"/><Text text="{dash>savingFmt}"/></HBox>
									</VBox>
								</VBox>
							</items>
						</VBox>
						<HBox class="grandTotal" visible="{dash>/hasData}"><Text text="Grand Total"/><Text text="{dash>/grandTotal/boqFmt}"/><Text text="{dash>/grandTotal/poFmt}"/><Text text="{dash>/grandTotal/availabilityFmt}"/><Text text="{dash>/grandTotal/savingFmt}"/></HBox>
					</VBox>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>
